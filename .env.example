# Template for the local .env file:  copy .env.example .env   (then adjust the values)
#
# .env is git-ignored; this file is committed and must never contain a real secret.
# It documents WHICH variables exist. Precedence: constructor argument > environment variable > .env > default.
# Every application variable has the CRP_ prefix (campaign response project).

# --- logging ---
CRP_LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR
CRP_LOG_FORMAT=text           # text | json

# --- paths ---
CRP_DATA_DIR=data

# --- MLflow ---
# From the host: http://localhost:5500. Inside the compose network: http://mlflow:5000
CRP_MLFLOW_TRACKING_URI=http://localhost:5500
