# Secrets
.env
.env.*
!.env.example
secrets/
.dvc/config.local
*.pem
*.key
*.p12

# Data (DVC). Ignore data files by pattern, never a data directory (e.g. /data/raw/*): DVC's own gitignore matcher
# then treats the directory as ignored and silently skips the *.dvc pointers inside it.
/data/**/*.csv
/data/**/*.parquet
.dvc/cache/
.dvc/tmp/

# MLflow / model artifacts
mlruns/
mlartifacts/
mlflow.db
*.pkl
*.joblib
models/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Test and tool caches
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyright/

.ipynb_checkpoints/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime output
*.log
reports/
